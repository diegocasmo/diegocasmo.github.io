---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildPerson } from '../data/person';

const siteURL = Astro.site!.href;
const description =
  'Diego Castillo is a senior software engineer at Buffer who builds simple, thoughtful products.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: new URL('/about/', Astro.site).href,
  mainEntity: buildPerson({ siteURL, description }),
};
---

<BaseLayout title="About" description={description} jsonLd={jsonLd}>
  <div class="page">
    <h1 class="sr-only">About</h1>

    <p>I'm Diego. I build simple, thoughtful products.</p>

    <p>
      I work with a fully remote team{' '}
      <a href="https://buffer.com/" target="_blank" rel="noopener">
        @buffer.com
      </a>{' '}
      creating social media tools for creators and small businesses. I mostly
      work where products meet AI agents. I want to solve problems for people
      and/or their agents, and turn ideas into successful products.
    </p>

    <p>
      On the side I build my own things, like{' '}
      <a href="https://www.tonebuilder.ai/" target="_blank" rel="noopener">
        ToneBuilder
      </a>{' '}
      and{' '}
      <a href="https://www.findmomentum.xyz/" target="_blank" rel="noopener">
        Momentum
      </a>
      . A few more are on the <a href="/products/">products</a> page. I also
      play jazz as{' '}
      <a
        href="https://www.youtube.com/@diegocasmo"
        target="_blank"
        rel="noopener"
      >
        @diegocasmo
      </a>
      .
    </p>

    <p>
      My work history is on my <a href="/resume.md">resume</a> and{' '}
      <a
        href="https://www.linkedin.com/in/diegocasmo/"
        target="_blank"
        rel="noopener"
      >
        LinkedIn
      </a>
      . You can also find me on{' '}
      <a href="https://github.com/diegocasmo" target="_blank" rel="noopener">
        GitHub
      </a>{' '}
      and{' '}
      <a href="https://x.com/diegocasmo" target="_blank" rel="noopener">
        X
      </a>
      .
    </p>
  </div>
</BaseLayout>

<style>
  .page p {
    margin-bottom: 1.2em;
  }
</style>
