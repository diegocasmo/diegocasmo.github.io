---
import BaseLayout from '../layouts/BaseLayout.astro';

const PRODUCTS = [
  {
    title: 'tonebuilder.ai',
    description: 'An AI-powered, chat-based tone architect for Line 6 Helix.',
    url: 'https://tonebuilder.ai/',
  },
  {
    title: 'stem-to-master',
    description: 'Mix and master your stems autonomously, as code.',
    githubUrl: 'https://github.com/diegocasmo/stem-to-master',
  },
  {
    title: 'colorist',
    description: 'An AI-driven color grading tool for videos.',
    githubUrl: 'https://github.com/diegocasmo/colorist',
  },
  {
    title: 'findmomentum.xyz',
    description:
      'A productivity app that helps track and celebrate daily progress through small wins.',
    url: 'https://findmomentum.xyz/',
    githubUrl: 'https://github.com/diegocasmo/findmomentum',
  },
  {
    title: 'Pocket Ledger',
    archived: true,
    description: 'A local-first expense tracker. No accounts. No cloud.',
    url: 'https://pocket-ledger-rho.vercel.app/calendar',
    githubUrl: 'https://github.com/diegocasmo/pocket-ledger',
  },
];
---

<BaseLayout
  title="Products"
  description="Products built by Diego Castillo: tonebuilder.ai, stem-to-master, colorist, findmomentum.xyz, and Pocket Ledger."
>
  <div class="page">
    <h1 class="sr-only">Products</h1>
    <ul class="products">
      {PRODUCTS.map((product) => (
        <li>
          <a
            href={product.url ?? product.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {product.title}
          </a>
          {product.archived && ' (archived)'}: {product.description}
          {product.url && product.githubUrl && (
            <>
              {' '}
              (
              <a
                href={product.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                source
              </a>
              )
            </>
          )}
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  /* Matches the dash's left: -20px (main.css) so it sits on the page's left edge */
  .products {
    margin-left: 20px;
  }

  .products li + li {
    margin-top: 0.75em;
  }
</style>
